<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:gravity="center_vertical" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOOR · NEXT OCCASION" android:textAllCaps="true" android:textColor="#E7C878" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="#FFF9F0" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#D8E7DE" android:textSize="14sp" />
    <TextView android:id="@+id/widget_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:ellipsize="end" android:maxLines="1" android:textColor="#FFF9F0" android:textSize="14sp" />
    <TextView android:id="@+id/widget_open" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#E7C878" android:paddingLeft="12dp" android:paddingTop="7dp" android:paddingRight="12dp" android:paddingBottom="7dp" android:text="OPEN PLAN" android:textColor="#173B30" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
